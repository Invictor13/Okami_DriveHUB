# ==============================================================================
# Okami DriveHUB — Exemplo de Variáveis de Ambiente
# ==============================================================================
# IMPORTANTE: Nunca insira credenciais reais ou segredos privados neste arquivo.
# Copie este arquivo para .env.local e insira seus valores reais locais.
# ==============================================================================

# Google Identity Services (GIS) — OAuth 2.0 Client ID (Público no Frontend)
# Obtenha em: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Metadados da Aplicação
VITE_APP_TITLE=Okami DriveHUB
VITE_APP_ENV=development

